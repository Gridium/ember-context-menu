<span class="context-menu__item__label">
  {{#if this.item.icon}}
    <i class="fa fa-{{this.item.icon}} context-menu__item__icon"></i>
  {{/if}}
  {{this.item.label}} {{#if this._amount}}({{this._amount}}){{/if}}
</span>

{{#if this.item.subActions}}
  {{#unless this.isDisabled}}
    <ul class="context-menu--sub">
      {{#each this.item.subActions as |subItem|}}
        {{context-menu-item
          item=subItem
          amount=this.amount
          itemIsDisabled=this.itemIsDisabled
          clickAction=this.clickAction
        }}
      {{/each}}
    </ul>
  {{/unless}}
{{/if}}
